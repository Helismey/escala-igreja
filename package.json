{
  "name": "escala-igreja",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @escala-igreja/web dev",
    "build": "turbo run build",
    "build:raw": "pnpm -r --filter=!@escala-igreja/web build && pnpm --filter @escala-igreja/web build",
    "start": "pnpm --filter @escala-igreja/web start",
    "test": "vitest run",
    "test:unit": "vitest run packages/domain/test/scheduling.test.ts packages/domain/test/authz.test.ts packages/domain/test/crypto-and-auth.test.ts packages/domain/test/availability.test.ts packages/domain/test/notifications.test.ts packages/domain/test/overload-detector.test.ts packages/domain/test/auto-scheduler.test.ts packages/domain/test/auto-substitution.test.ts packages/domain/test/member-profile.test.ts packages/domain/test/action-token.test.ts packages/domain/test/menu-and-theme.test.ts packages/domain/test/swap-rules.test.ts packages/domain/test/calendar.test.ts",
    "test:prop": "vitest run packages/domain/test/scheduling.prop.test.ts",
    "test:matrix": "vitest run packages/domain/test/authz-matrix.test.ts",
    "test:concurrency": "vitest run packages/domain/test/concurrency.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "test:mutation": "stryker run packages/domain/stryker.config.json",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @escala-igreja/db generate",
    "db:push": "pnpm --filter @escala-igreja/db push",
    "db:migrate:dev": "pnpm --filter @escala-igreja/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @escala-igreja/db migrate:deploy",
    "db:seed": "pnpm --filter @escala-igreja/db seed",
    "cap:sync": "pnpm --filter @escala-igreja/web cap:sync",
    "cap:open:android": "pnpm --filter @escala-igreja/web cap:open:android"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.10",
    "turbo": "^2.11.6",
    "typescript": "^5.8.2",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "deepmerge-ts": "^8.0.0",
      "qs": "^6.16.0",
      "uuid": "^14.0.2"
    }
  }
}
